# Doveify Web System — line ending normalization
#
# Tum text dosyalari repository icinde LF olarak saklanir.
# Windows ortamlarinda CRLF karmasasini ve sahte diff'leri engeller.

* text=auto eol=lf

# Acikca text olarak isaretlenenler
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.sh        text eol=lf
*.gitignore text eol=lf
*.gitkeep   text eol=lf

# Windows'a ozgu script'ler CRLF kalmalidir
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary — Git bunlara dokunmaz
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.avif      binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.mp4       binary
*.webm      binary
*.mov       binary
*.zip       binary
